# Configuración del servidor DetectaEmociones Backend
APP_NAME="DetectaEmociones API"
APP_VERSION="1.0.0"
DEBUG=false

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Tamaño máximo de imagen permitido en bytes (por defecto 5 MB = 5242880)
MAX_IMAGE_SIZE_BYTES=5242880

# Detector facial utilizado por DeepFace (opencv, ssd, mtcnn, retinaface, mediapipe, yolov8, centerface)
# 'opencv' es el más rápido y no requiere descargas pesadas adicionales en CPU.
DEEPFACE_DETECTOR_BACKEND="opencv"

# Pre-cargar el modelo de emociones al iniciar el servidor (true/false)
PRELOAD_MODEL_ON_STARTUP=true
